[global]
    monitor = 0
    follow = mouse

    origin = top-right
    offset = 12x40
    scale = 0

    width = 350
    height = 300
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 10
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300

    indicate_hidden = yes
    transparency = 6
    separator_height = 2
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 2
    frame_color = "#c27193"
    separator_color = frame
    corner_radius = 8
    sort = yes

    gap_size = 6

    idle_threshold = 120

    font = JetBrainsMono Nerd Font 11
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    icon_position = left
    min_icon_size = 32
    max_icon_size = 64
    icon_theme = "Papirus-Dark, Adwaita, hicolor"
    enable_recursive_icon_lookup = true

    sticky_history = yes
    history_length = 30

    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/xdg-open

    always_run_script = true
    title = Dunst
    class = Dunst

    mouse_left_click = close_current
    mouse_middle_click = close_all
    mouse_right_click = context

[experimental]
    per_monitor_dpi = false

[urgency_low]
    background = "#343061"
    foreground = "#e5dfe6"
    frame_color = "#7b91fc"
    timeout = 4
    default_icon = dialog-information

[urgency_normal]
    background = "#343061"
    foreground = "#e5dfe6"
    frame_color = "#c27193"
    timeout = 8
    default_icon = dialog-information

[urgency_critical]
    background = "#343061"
    foreground = "#e5dfe6"
    frame_color = "#fc4649"
    timeout = 0
    default_icon = dialog-warning

# Match the wifi popup notifications (if you still send any via notify-send)
[wifi]
    appname = "Wi-Fi"
    background = "#343061"
    foreground = "#e5dfe6"
    frame_color = "#7b91fc"

# Volume notifications
[volume]
    appname = "Volume"
    background = "#343061"
    foreground = "#e5dfe6"
    frame_color = "#AC82E9"

# Battery warnings pop as critical automatically via urgency_critical above